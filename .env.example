# ============================================================================
# SDOC settings. Copy this file to .env and edit it:   cp .env.example .env
# .env is git-ignored: your key never gets committed. Real environment
# variables (e.g. set by a cloud platform) override what's in .env.
# ============================================================================

# ---- AI ----------------------------------------------------------------------
# Any OpenAI-compatible chat API. Default is Groq: get a key at console.groq.com
# Leave LLM_API_KEY empty to run without AI (rules + OCR only - still works).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Other providers - change the key, the URL, and the model names
# (pick models from that provider's current model list):
#   xAI Grok : LLM_BASE_URL=https://api.x.ai/v1
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1
#   Ollama   : LLM_BASE_URL=http://localhost:11434/v1   (local; any key works)
#
# Switch the AI off without deleting the key:
# SDOC_DISABLE_AI=1

# ---- Data --------------------------------------------------------------------
# Either the extracted data folder (inbox/ + attachments/), relative to this
# project folder or absolute...
SDOC_DATA=data_v2
# ...or the organizers' Docker server (docker compose up -> port 8080):
# SDOC_DATA=http://localhost:8080
#
# Where results go (submission.json, report.md, review queue...)
SDOC_OUT=output
# Only for `python -m sdoc score` if the ground truth isn't <data>/ground_truth.json
# SDOC_GROUND_TRUTH=

# ---- Pipeline behaviour ------------------------------------------------------
# ai    = AI reads PDF/DOCX/XLSX/scans, rule parser cross-checks (default)
# auto  = rules first, AI only for what the rules can't find (fewest AI calls)
# rules = never call the AI
SDOC_EXTRACTION_MODE=ai
# review = scanned documents always go to a human with a proposal (default)
# trust  = compare scans automatically when OCR confidence >= SDOC_OCR_TRUST_MIN
SDOC_OCR_POLICY=review
SDOC_OCR_TRUST_MIN=0.95
# OCR / AI results are cached here so reruns don't spend quota
SDOC_CACHE_DIR=.sdoc_cache
# SDOC_NO_CACHE=1

# ---- Web app -----------------------------------------------------------------
SDOC_API_HOST=127.0.0.1
SDOC_API_PORT=8000
# Browser origins allowed to call the API (the Vite dev server by default)
SDOC_CORS=http://localhost:5173
# Only if the UI is hosted separately from the API (e.g. in the cloud):
# VITE_API_URL=https://your-api.example.com

# ---- Public deployment -------------------------------------------------------
# (the Dockerfile already sets sensible values for these; see DEPLOY.md)
# Results pre-computed at image build time (the Dockerfile sets this); loaded
# instantly on startup when there are no results yet:
# SDOC_SEED_DIR=
# Otherwise, process the inbox automatically when the server starts with no results:
# SDOC_AUTORUN=1
# Minimum seconds between full runs started from the web UI:
# SDOC_RUN_COOLDOWN=300
# If set, starting a full run needs this token (the UI asks for it once):
# SDOC_ADMIN_TOKEN=
# Upload & Check limits (each check may call the AI on your key):
# SDOC_MAX_UPLOAD_MB=10
# SDOC_CHECKS_PER_HOUR=30
# Whole-inbox uploads (zip / .json / .eml): size, emails per batch, batches per IP per hour
# SDOC_MAX_BATCH_MB=60
# SDOC_MAX_BATCH_EMAILS=1000
# SDOC_BATCHES_PER_HOUR=6

# ---- Deploying to Hugging Face Spaces (python deploy/deploy_hf.py) -----------
# A *write* token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Your Space: username/space-name  (created automatically if it doesn't exist)
HF_SPACE=
